# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code agent worktrees
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# スタンドアロン版ビルド(scripts/build-standalone.mjs)が異常終了した場合に
# 残ることがある退避ディレクトリ
/.standalone-build-backup

# prisma
# DATABASE_URL="file:./dev.db" は実行時のカレントディレクトリ(リポジトリ直下)を
# 基準に解決されるため、prisma/配下ではなくリポジトリ直下にファイルが作成される。
/dev.db
/*.db
/*.db-journal
/prisma/dev.db
/prisma/*.db
/prisma/*.db-journal
