// 確定申告支援ツール データモデル
//
// 対象範囲(初期版):
//  - 暗号資産(仮想通貨)取引 -> 雑所得の計算
//  - 有価証券(株式・投資信託等)取引 -> 譲渡所得/配当所得の計算
//  - マネーフォワード ME からインポートした取引明細
//
// 将来的に確定申告書等作成コーナーへの連携・e-Taxデータ出力を強化する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 課税年度(申告対象の暦年)。日本の所得税は暦年単位(1/1-12/31)で計算する。
model TaxYear {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  createdAt DateTime @default(now())

  /// 暗号資産の評価方法。所得税法上、届出が無い場合の法定算出方法は総平均法。
  /// 移動平均法を選択する場合は税務署への届出(所得税の暗号資産の評価方法の
  /// 届出書)が必要で、一度選択すると原則3年間変更できない点に注意。
  cryptoCostMethod CryptoCostMethod @default(AVERAGE)

  cryptoTrades                            CryptoTrade[]
  cryptoMarginTrades                      CryptoMarginTrade[]
  futuresTrades                           FuturesTrade[]
  investmentTrades                        InvestmentTrade[]
  importBatches                           ImportBatch[]
  openingBalances                         OpeningBalance[]
  openingBalancesByInstitution            OpeningBalanceByInstitution[]
  investmentLossCarryforwards             InvestmentLossCarryforward[]
  futuresLossCarryforwards                FuturesLossCarryforward[]
  brokerAnnualReports                     BrokerAnnualReport[]
  assetBalanceSnapshots                   AssetBalanceSnapshot[]
  foreignTaxCreditCarryforwards           ForeignTaxCreditCarryforward[]
  foreignTaxCreditSpareLimitCarryforwards ForeignTaxCreditSpareLimitCarryforward[]
  incomeDeductions                        IncomeDeduction[]
  nisaLifetimeQuotas                      NisaLifetimeQuota[]
}

enum CryptoCostMethod {
  /// 総平均法(届出が無い場合の法定算出方法)
  AVERAGE
  /// 移動平均法(税務署への届出により選択可能)
  MOVING_AVERAGE
}

/// 前年からの繰越残高(期首残高)。暗号資産・株式等の総平均法/移動平均法による
/// 取得費計算は複数年にまたがるため、年初の保有数量と取得価額の合計を
/// ここに保持し、当年の計算エンジンへ opening 引数として渡す。
model OpeningBalance {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  assetClass OpeningBalanceAssetClass

  /// 銘柄シンボル・銘柄コード(CryptoTrade.symbol / InvestmentTrade.symbol と対応)
  symbol String

  /// 投資(INVESTMENT)のみ有効。NISA口座分の期首残高かどうか。
  /// NISA口座は課税口座と別ロットのため、同一銘柄でも別レコードになる。
  /// 暗号資産(CRYPTO)では常に false。
  isNisa Boolean @default(false)

  /// 年初時点の保有数量
  quantity Decimal

  /// 年初時点の取得価額の合計(単価ではなく総額)
  costBasisJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, assetClass, symbol, isNisa])
}

/// 期首残高の金融機関別内訳(任意)。`OpeningBalance`は銘柄単位の合計しか
/// 持たないため、同一銘柄を複数の金融機関(取引所・証券会社)にまたがって
/// 保有している場合、マネーフォワード資産残高突合の数量チェック
/// (`assetBalanceReconciliation.ts`)では期首残高をどの金融機関に帰属させる
/// べきか判定できず「判定不能(期首残高の按分不可)」として見送られる。
/// このテーブルに銘柄×金融機関ごとの期首数量を登録すると、その金融機関に
/// ついてはここで登録した数量を使って数量突合ができるようになる
/// (未登録の金融機関は従来通り判定不能のまま)。既存の`OpeningBalance`とは
/// 独立した追加データのため、登録しなくても既存の計算・突合は変わらない。
model OpeningBalanceByInstitution {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  assetClass OpeningBalanceAssetClass

  /// 銘柄シンボル・銘柄コード(OpeningBalance.symbolと対応)
  symbol String

  /// 金融機関名(CryptoTrade.exchange / InvestmentTrade.broker と対応)
  institution String

  /// 年初時点の、この金融機関における保有数量
  quantity Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, assetClass, symbol, institution])
}

enum OpeningBalanceAssetClass {
  CRYPTO
  INVESTMENT
}

/// 上場株式等の譲渡損失の繰越控除(3年間)。確定申告により繰越控除の適用を
/// 受けた損失のうち、taxYearId の年初時点でまだ使い切っていない残高を
/// 発生年(originYear)ごとに保持する。控除は発生年の翌年以後3年間のみ有効で、
/// 計算エンジン側(src/lib/investment/lossCarryforward.ts)で発生年の古い順に
/// 当年の譲渡益から控除し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 暗号資産の損失(雑所得)は他の所得と損益通算・繰越ができないため対象外。
model InvestmentLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// FX・先物・CFD等(「先物取引に係る雑所得等」)の損失の繰越控除(3年間)。
/// InvestmentLossCarryforwardと同じ制度(発生年の翌年以後3年間、同区分の所得
/// からのみ控除可能)だが、上場株式等の譲渡所得とはプールが完全に分かれており
/// 相互に流用できないため、別テーブルとして保持する。taxYearId の年初時点で
/// まだ使い切っていない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (src/lib/investment/lossCarryforward.ts の calculateLossCarryforward を
/// FuturesTrade分に対して再利用する)で発生年の古い順に当年の損益から控除し、
/// 期限(発生年+3年)を超えた分は自動的に無効とする。
model FuturesLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除限度超過額。国外所得税額のうち、
/// その年の控除限度額を超えて控除しきれなかった額は、発生した年分の翌年以後
/// 3年間繰り越して、限度額に余りが生じた年の控除に充当できる。
/// InvestmentLossCarryforward と同様、taxYearId の年初時点でまだ使い切って
/// いない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (src/lib/investment/foreignTaxCredit.ts)で発生年の古い順に当年の限度額の
/// 余りへ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 限度額に余りが生じた場合の「控除余裕額」側の繰越は
/// ForeignTaxCreditSpareLimitCarryforward で別途保持する。
model ForeignTaxCreditCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除限度超過額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な限度超過額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除余裕額。ある年の控除限度額に対して
/// 外国所得税額が少なく限度額が余った場合、その余裕額は発生した年分の翌年以後
/// 3年間繰り越して、外国所得税額が限度額を超えた年(控除限度超過額が発生する年)
/// の控除に充当できる。ForeignTaxCreditCarryforward(限度超過額側)と対になる
/// 繰越で、taxYearId の年初時点でまだ使い切っていない残高を発生年(originYear)
/// ごとに保持し、計算エンジン側(src/lib/investment/foreignTaxCredit.ts)で発生年の
/// 古い順に当年の限度超過額へ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
model ForeignTaxCreditSpareLimitCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除余裕額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越可能な控除余裕額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 所得控除試算画面(医療費控除・生命保険料控除・小規模企業共済等掛金控除
/// (iDeCo等)・社会保険料控除)で算出した年間の控除額を、年分・控除区分ごとに
/// 保存する。各試算画面はそれ単独では暗号資産・投資の集計とは独立しており
/// 自動連携していなかったが、ここに登録することで`/tax-estimate`の
/// 「給与所得等の課税所得金額」の初期値に自動反映できるようにする
/// (登録後も入力欄は手入力で上書き可能)。生命保険料控除は所得税と住民税とで
/// 速算表が異なり控除額が一致しないことがあるため、区分によらず所得税用・
/// 住民税用の金額を別々に保持する(生命保険料控除以外は両者に同額を入れる)。
model IncomeDeduction {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  type IncomeDeductionType

  /// 所得税の控除額
  incomeTaxAmountJpy Decimal

  /// 住民税の控除額(生命保険料控除以外は incomeTaxAmountJpy と同額)
  residentTaxAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, type])
}

enum IncomeDeductionType {
  /// 医療費控除(src/lib/medicalExpenseDeduction.ts)
  MEDICAL_EXPENSE
  /// 生命保険料控除(src/lib/lifeInsuranceDeduction.ts)
  LIFE_INSURANCE
  /// 地震保険料控除(src/lib/earthquakeInsuranceDeduction.ts)
  EARTHQUAKE_INSURANCE
  /// 小規模企業共済等掛金控除・iDeCo等(src/lib/smallBusinessMutualAidDeduction.ts)
  SMALL_BUSINESS_MUTUAL_AID
  /// 社会保険料控除(src/lib/socialInsuranceDeduction.ts)
  SOCIAL_INSURANCE
  /// セルフメディケーション税制(src/lib/selfMedicationDeduction.ts)。
  /// MEDICAL_EXPENSEとは選択制で併用できないため、合計額の算出では
  /// 両方が登録されている場合に有利な方のみを採用する(incomeDeduction.ts参照)。
  SELF_MEDICATION
  /// 配偶者控除・配偶者特別控除(src/lib/dependentDeduction.ts)
  SPOUSE
  /// 扶養控除(src/lib/dependentDeduction.ts)
  DEPENDENT
  /// 基礎控除(src/lib/basicDeduction.ts)
  BASIC
}

/// NISA生涯投資枠(2024年以降の新NISA制度における総枠1,800万円・
/// うち成長投資枠1,200万円)の使用状況試算用データ。年間投資枠
/// (src/lib/investment/nisaQuota.ts の calculateNisaQuotaUsage)はその年の
/// 買付だけを見れば判定できるが、生涯投資枠は過去の買付・売却の累積
/// (簿価残高)を追わないと判定できない。売却により再利用可能になった枠は
/// 売却した年の翌年から使えるようになるため、本テーブルには taxYearId の
/// 年始時点で確定している「使用額」(前年末の保有簿価残高)を枠区分ごとに
/// 保持し、当年の買付額を加算して当年末の使用額(翌年への繰越額)を計算する。
/// 当年中に売却した保有分の取得価額(簿価)は自動追跡せず、ユーザーが
/// soldCostBasisJpy に手入力する(OpeningBalance等と同様、本ツールが
/// 過去の取引を全件保持している保証がないための簡略化)。
model NisaLifetimeQuota {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  nisaType InvestmentNisaType

  /// 年始時点の非課税枠使用額(前年末時点の保有簿価残高)
  openingUsedJpy Decimal

  /// 当年中に売却した、この枠で買い付けた保有分の取得価額(簿価)の合計(手入力)。
  /// 翌年への繰越額(=翌年の年始使用額)の算出にのみ使う
  /// (売却による枠の再利用は翌年からのため、当年の買付可否判定には使わない)。
  soldCostBasisJpy Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, nisaType])
}

/// 暗号資産の売買・交換・使用等の取引履歴。
/// 国税庁「暗号資産に関する税務上の取扱いについて」に基づき、
/// 総平均法(または移動平均法)で1単位あたりの取得価額を算出する。
model CryptoTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 取引日時 (JST)
  tradedAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// buy: 円などの法定通貨で購入 / sell: 法定通貨に売却
  /// trade_in / trade_out: 暗号資産同士の交換(この取引で増える/減る側)
  /// income: マイニング・ステーキング・エアドロップ等による取得(取得時時価で収入計上)
  /// fee: 取引手数料(暗号資産建てで支払われた場合)
  type CryptoTradeType

  /// 数量(増減の絶対値)。取得数量 or 譲渡数量。
  quantity Decimal

  /// 単価(日本円換算)。income/tradeでは取得時の時価を入力する。
  unitPriceJpy Decimal

  /// 手数料(日本円換算、取得価額 or 譲渡価額の調整に使用)
  feeJpy Decimal @default(0)

  /// 取引所・ウォレット名
  exchange String?

  /// メモ
  memo String?

  /// インポート元(手動 / moneyforward / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

enum CryptoTradeType {
  BUY
  SELL
  TRADE_IN
  TRADE_OUT
  INCOME
  FEE
}

/// 暗号資産の証拠金(レバレッジ)取引の決済損益。DMM Bitcoin・SBI VCトレード等の
/// 証拠金取引は、現物取引のように数量×単価で取得費を積み上げる総平均法/移動
/// 平均法の計算モデルにはあてはまらず、決済(反対売買)のたびに確定する
/// 建玉損益がそのまま雑所得の収入・損失になる。そのため CryptoTrade とは別に、
/// 決済ごとの損益をそのまま合算するだけのシンプルなモデルとして保持する。
model CryptoMarginTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買が成立した日時)
  settledAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// 決済損益(円)。建玉を閉じた際の損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 取引手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// スワップポイント・建玉管理料等(円)。損益に加算する(費用の場合は負の値)。
  swapJpy Decimal @default(0)

  /// 取引所名
  exchange String?

  memo String?

  /// インポート元(手動 / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

/// FX(店頭外国為替証拠金取引)・先物・CFD等の決済損益。所得税法上「先物取引に
/// 係る雑所得等」として、上場株式等の譲渡所得(InvestmentTrade)や暗号資産の
/// 雑所得(CryptoTrade/CryptoMarginTrade)とは別区分の申告分離課税
/// (一律20.315%)の対象になり、損益通算・繰越控除も他の所得区分とは
/// プールを分けて計算しなければならない。CryptoMarginTradeと同様、建玉の
/// 決済(反対売買・差金決済)のたびに確定する損益をそのまま合算するだけの
/// シンプルなモデルとして保持する(数量×単価による取得費の積み上げは行わない)。
model FuturesTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買・差金決済が成立した日時)
  settledAt DateTime

  /// 銘柄・通貨ペア名 (例: USD/JPY, 日経225先物)
  symbol String

  /// 決済損益(円)。建玉を閉じた際の損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 取引手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// スワップポイント等(円。FXのみ発生。損益に加算する。費用の場合は負の値)
  swapJpy Decimal @default(0)

  /// 取引業者名
  broker String?

  memo String?

  /// インポート元(手動 / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

/// 株式・投資信託・ETF等の売買履歴。
/// 特定口座(源泉徴収あり/なし)・一般口座・NISA区分を保持し、
/// 譲渡所得(申告分離課税)の計算に使う。
model InvestmentTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  tradedAt DateTime

  /// 銘柄コード・ティッカー
  symbol String

  /// 銘柄名
  name String?

  assetType InvestmentAssetType

  type InvestmentTradeType

  quantity Decimal

  /// 約定単価(円)
  unitPriceJpy Decimal

  /// 手数料(円)
  feeJpy Decimal @default(0)

  /// 口座区分
  accountType InvestmentAccountType @default(SPECIFIC_WITHHOLDING)

  /// NISA区分(該当する場合、非課税のため損益計算から除外)
  isNisa Boolean @default(false)

  /// NISAの年間投資枠区分(isNisa=true かつ type=BUY の場合のみ入力する想定)。
  /// つみたて投資枠(年120万円)・成長投資枠(年240万円)の使用状況試算
  /// (src/lib/investment/nisaQuota.ts)に使う。未入力(null)の場合は
  /// どちらの枠の使用額にも計上されず、試算画面で「未分類」として警告表示する。
  nisaType InvestmentNisaType?

  /// 国外で発行された株式・投資信託等かどうか。米国株等の配当は現地でも
  /// 源泉徴収されることが多く、外国税額控除(所得税法95条)の対象となる
  /// 国外所得金額の自動集計に使う(type=DIVIDENDのレコードのみ対象)。
  isForeign Boolean @default(false)

  /// 配当・分配金(type=DIVIDEND)につき現地で源泉徴収された外国所得税額
  /// (日本円換算、isForeign=trueの場合のみ入力する想定)。
  /// `/foreign-tax-credit`の外国所得税額の自動集計に使う。
  foreignTaxWithheldJpy Decimal @default(0)

  broker String?
  memo   String?

  source        String       @default("manual")
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

enum InvestmentAssetType {
  STOCK
  ETF
  MUTUAL_FUND
  BOND
  OTHER
}

enum InvestmentTradeType {
  BUY
  SELL
  DIVIDEND
}

enum InvestmentAccountType {
  SPECIFIC_WITHHOLDING
  SPECIFIC_NO_WITHHOLDING
  GENERAL
  NISA
}

/// NISAの年間投資枠区分(2024年以降の新NISA制度)
enum InvestmentNisaType {
  /// つみたて投資枠(年間上限120万円)
  TSUMITATE
  /// 成長投資枠(年間上限240万円)
  GROWTH
}

/// 証券会社が発行する「特定口座年間取引報告書」の年間サマリー数値。
/// 損益計算そのものには使わず、アプリ内でInvestmentTradeから計算した
/// 証券会社・口座区分ごとの譲渡収入金額・配当等の額と突き合わせて、
/// 取引の入力漏れ・入力ミスを検知するための参照データとして保持する。
/// 取得費は証券会社が口座ごとに管理する取得原価(本ツールが銘柄単位・
/// 全口座合算で計算する平均単価とは前提が異なる)のため自動突合の対象にはせず、
/// 参考値として登録するのみとする。
model BrokerAnnualReport {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 証券会社名(InvestmentTrade.broker と同じ表記で入力する想定)
  broker String

  /// 口座区分。年間取引報告書が発行されるのは通常、特定口座(源泉徴収あり/なし)。
  accountType InvestmentAccountType

  /// 年間取引報告書「譲渡の対価の額(収入金額)」の合計
  proceedsJpy Decimal

  /// 年間取引報告書「取得費及び譲渡に要した費用の額等」の合計(参考値。自動突合の対象外)
  acquisitionCostJpy Decimal

  /// 年間取引報告書「配当等の額」の合計(任意)
  dividendJpy Decimal @default(0)

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, broker, accountType])
}

/// マネーフォワード ME 等からインポートしたCSVの取り込みバッチ。
/// 生データを保持し、後から再取り込み・突合ができるようにする。
model ImportBatch {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// moneyforward_cashflow / moneyforward_assets / crypto_csv / investment_csv
  sourceType String

  fileName   String
  importedAt DateTime @default(now())
  rowCount   Int      @default(0)

  cryptoTrades          CryptoTrade[]
  cryptoMarginTrades    CryptoMarginTrade[]
  futuresTrades         FuturesTrade[]
  investmentTrades      InvestmentTrade[]
  cashflowEntries       CashflowEntry[]
  assetBalanceSnapshots AssetBalanceSnapshot[]
}

/// マネーフォワード ME の家計簿(収支)データ。
/// 事業所得・雑所得の経費按分や、暗号資産取引の見落とし検出などに利用する。
model CashflowEntry {
  id            Int         @id @default(autoincrement())
  importBatchId Int
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])

  date                DateTime
  content             String
  amountJpy           Decimal
  /// 収入 / 支出
  direction           CashflowDirection
  largeCategory       String?
  middleCategory      String?
  institution         String?
  memo                String?
  /// マネーフォワード側の計算対象フラグ(集計除外の振替等を判別)
  isCalculationTarget Boolean           @default(true)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([largeCategory, middleCategory])
}

enum CashflowDirection {
  INCOME
  EXPENSE
}

/// マネーフォワードの資産名(例:「ビットコイン」)とアプリ側の銘柄シンボル
/// (例:「BTC」。CryptoTrade.symbol / InvestmentTrade.symbol と対応)の
/// 対応表。資産残高突合(assetBalanceReconciliation.ts)で、金融機関単位の
/// 突合に加えて銘柄単位での突合まで踏み込むために使う。対応関係は年をまたいで
/// 変わらないマスタデータのため、TaxYearには紐付けない全年共通のテーブルとする。
model AssetSymbolMapping {
  id Int @id @default(autoincrement())

  /// マネーフォワード側の資産名表記(完全一致で対応付ける)
  assetName String @unique

  /// アプリ側の銘柄シンボル・銘柄コード
  symbol String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 銘柄ごとの現在価格(時価)のユーザー手入力。自動取得の仕組みは持たない
/// (/import「現在価格(時価)の登録」欄から登録・更新する)。年に紐付かない
/// 全年共通のマスタデータで、以下2箇所から参照する:
///  - `/unrealized-gain`(含み損益シミュレーション)の現在価格欄の初期値
///  - `assetBalanceReconciliation.ts`の`reconcileAssetSymbolBalances`による
///    マネーフォワード資産残高突合の評価額比較(期首残高+当年増減の期待保有数量
///    ×この価格と、マネーフォワード側の評価額を比較する)。手入力の価格は
///    マネーフォワード側の評価時点とずれるため、大きな乖離のみを検知する目安
///    情報として扱う。
model MarketPrice {
  id Int @id @default(autoincrement())

  /// アプリ側の銘柄シンボル・銘柄コード(大文字で正規化して保存する)
  symbol String @unique

  /// 1単位あたりの現在価格(円)
  priceJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// パスワード認証のログイン失敗試行(ブルートフォース対策)。IPアドレス単位で
/// 直近の失敗回数を数え、一定回数を超えたら一時的にログインを拒否する
/// (src/lib/auth/loginRateLimit.ts)。TaxYearに紐付かない全年共通のテーブル。
/// 成功時はそのIPアドレス分のレコードを削除し、期限切れレコードも都度削除する
/// ため、長期間肥大化しない。
model LoginAttempt {
  id Int @id @default(autoincrement())

  /// 失敗した接続元のIPアドレス(X-Forwarded-For等から取得。取得できない場合は"unknown")
  ipAddress String

  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

/// マネーフォワード ME の「資産の内訳」CSVから取り込んだ、ある時点の
/// 金融機関・資産別の残高(評価額)。損益計算そのものには使わず、アプリに
/// 登録済みの暗号資産・投資取引の金融機関(CryptoTrade.exchange /
/// InvestmentTrade.broker)と突き合わせて、残高はあるのに取引明細が
/// 一件も登録されていない金融機関(計上漏れの疑い)や、逆に取引明細は
/// あるのにマネーフォワード側の資産残高に見当たらない金融機関を検知する
/// 参照データとして保持する(src/lib/moneyforward/assetBalanceReconciliation.ts)。
/// CSVの列見出しは公開情報から確認できておらず未検証のため、専用プリセットは
/// 用意せずユーザーが列名を指定する汎用マッピング方式のみで取り込む。
model AssetBalanceSnapshot {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 残高時点の日付(CSVに日付列が無い/指定しない場合はインポート日時を使う)
  snapshotDate DateTime @default(now())

  /// マネーフォワード側の大分類・種類(任意。列を指定しない場合は空文字)
  category String @default("")

  /// 保有金融機関名(例: bitFlyer, SBI証券)。CryptoTrade.exchange /
  /// InvestmentTrade.broker と同じ表記を想定する。
  institution String

  /// 資産名(例: ビットコイン、楽天・全世界株式インデックス・ファンド)
  assetName String

  /// 残高・評価額(円)
  balanceJpy Decimal

  /// 保有数量(任意)。列を指定しない/CSVに無い場合はnull。
  /// アプリ内取引明細から計算した数量との突合(quantityの整合性チェック)に使う。
  quantity Decimal?

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())

  @@index([taxYearId, institution])
}
