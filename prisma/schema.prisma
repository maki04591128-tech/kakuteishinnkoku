  adjustmentDeductionJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
}

/// 政党等・認定NPO法人等・公益社団法人等寄附金特別控除(税額控除。
/// src/lib/donationTaxCredit.ts)の当年分の試算結果を年分ごとに保存し、
/// `/tax-estimate`の合計税額試算・下書きCSVへ自動反映するためのデータ。
