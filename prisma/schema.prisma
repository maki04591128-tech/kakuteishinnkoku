  totalTaxCreditJpy            Decimal
  /// 認定NPO法人等・公益社団法人等への寄附のうち条例指定を受けている分の住民税の
  /// 寄附金控除(基本控除)額の合計(DonationTaxCreditResult.totalResidentTaxBasicDeductionJpy)
  residentTaxBasicDeductionJpy Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
