/// 居住年分の所得税額から控除しきれなかった金額(控除未済税額控除額)を、
/// 翌年分(1年間のみ)に繰り越すためのデータ。`taxYearId`は繰越額を使える年
/// (居住年の翌年)を指し、`originYear`はその繰越額が発生した居住年を指す。
/// `/certified-housing-construction-credit`の試算画面で発生年分の登録時に
/// 直接翌年分としてこのテーブルへ登録し(CasualtyLossCarryforwardの
/// 一括登録パターンと同様)、繰越を使う年の画面で
/// CertifiedHousingConstructionCreditRecord.creditJpy に合算した時点で
/// このレコードを削除する(1年限りの繰越のため、消費後にさらに繰り越すことはない)。
model CertifiedHousingConstructionCreditCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 繰越元(居住年)の年(暦年)
