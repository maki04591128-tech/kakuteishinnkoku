// 確定申告支援ツール データモデル
//
// 対象範囲(初期版):
//  - 暗号資産(仮想通貨)取引 -> 雑所得の計算
//  - 有価証券(株式・投資信託等)取引 -> 譲渡所得/配当所得の計算
//  - マネーフォワード ME からインポートした取引明細
//
// 将来的に確定申告書等作成コーナーへの連携・e-Taxデータ出力を強化する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 課税年度(申告対象の暦年)。日本の所得税は暦年単位(1/1-12/31)で計算する。
model TaxYear {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  createdAt DateTime @default(now())

  /// 暗号資産の評価方法。所得税法上、届出が無い場合の法定算出方法は総平均法。
  /// 移動平均法を選択する場合は税務署への届出(所得税の暗号資産の評価方法の
  /// 届出書)が必要で、一度選択すると原則3年間変更できない点に注意。
  cryptoCostMethod CryptoCostMethod @default(AVERAGE)

  cryptoTrades                                    CryptoTrade[]
  cryptoMarginTrades                              CryptoMarginTrade[]
  futuresTrades                                   FuturesTrade[]
  investmentTrades                                InvestmentTrade[]
  stockMarginTrades                               StockMarginTrade[]
  importBatches                                   ImportBatch[]
  openingBalances                                 OpeningBalance[]
  openingBalancesByInstitution                    OpeningBalanceByInstitution[]
  investmentLossCarryforwards                     InvestmentLossCarryforward[]
  futuresLossCarryforwards                        FuturesLossCarryforward[]
  brokerAnnualReports                             BrokerAnnualReport[]
  assetBalanceSnapshots                           AssetBalanceSnapshot[]
  foreignTaxCreditCarryforwards                   ForeignTaxCreditCarryforward[]
  foreignTaxCreditSpareLimitCarryforwards         ForeignTaxCreditSpareLimitCarryforward[]
  incomeDeductions                                IncomeDeduction[]
  nisaLifetimeQuotas                              NisaLifetimeQuota[]
  casualtyLossCarryforwards                       CasualtyLossCarryforward[]
  mortgageDeductionRecords                        MortgageDeductionRecord[]
  foreignTaxCreditRecords                         ForeignTaxCreditRecord[]
  residentTaxAdjustmentDeductionRecords           ResidentTaxAdjustmentDeductionRecord[]
  donationTaxCreditRecords                        DonationTaxCreditRecord[]
  distributionAdjustedForeignTaxCreditRecords     DistributionAdjustedForeignTaxCreditRecord[]
  earthquakeRenovationDeductionRecords            EarthquakeRenovationDeductionRecord[]
  energySavingRenovationDeductionRecords          EnergySavingRenovationDeductionRecord[]
  barrierFreeRenovationDeductionRecords           BarrierFreeRenovationDeductionRecord[]
  multiHouseholdRenovationDeductionRecords        MultiHouseholdRenovationDeductionRecord[]
  durabilityImprovementRenovationDeductionRecords DurabilityImprovementRenovationDeductionRecord[]
  childRearingRenovationDeductionRecords          ChildRearingRenovationDeductionRecord[]
  certifiedHousingConstructionCreditRecords       CertifiedHousingConstructionCreditRecord[]
  certifiedHousingConstructionCreditCarryforwards CertifiedHousingConstructionCreditCarryforward[]
  homeSaleLossCarryforwards                       HomeSaleLossCarryforward[]
  homeReplacementLossCarryforwards                HomeReplacementLossCarryforward[]
  employmentIncomeRecords                         EmploymentIncomeRecord[]
}

enum CryptoCostMethod {
  /// 総平均法(届出が無い場合の法定算出方法)
  AVERAGE
  /// 移動平均法(税務署への届出により選択可能)
  MOVING_AVERAGE
}

/// 前年からの繰越残高(期首残高)。暗号資産・株式等の総平均法/移動平均法による
/// 取得費計算は複数年にまたがるため、年初の保有数量と取得価額の合計を
/// ここに保持し、当年の計算エンジンへ opening 引数として渡す。
model OpeningBalance {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  assetClass OpeningBalanceAssetClass

  /// 銘柄シンボル・銘柄コード(CryptoTrade.symbol / InvestmentTrade.symbol と対応)
  symbol String

  /// 投資(INVESTMENT)のみ有効。NISA口座分の期首残高かどうか。
  /// NISA口座は課税口座と別ロットのため、同一銘柄でも別レコードになる。
  /// 暗号資産(CRYPTO)では常に false。
  isNisa Boolean @default(false)

  /// 投資(INVESTMENT)のみ有効。上場株式等(true)か一般株式等・非上場株式
  /// (false)かの区分(機能54参照)。両者は別プールの申告分離課税のため
  /// 同一銘柄でも取得費を別管理する必要がある。暗号資産(CRYPTO)では常に
  /// true(無視)。デフォルトtrueとすることで、この区分の追加前に登録済みの
  /// 株式等の期首残高(すべて上場株式等として登録されていた)の扱いを維持する。
  isListed Boolean @default(true)

  /// 年初時点の保有数量
  quantity Decimal

  /// 年初時点の取得価額の合計(単価ではなく総額)
  costBasisJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, assetClass, symbol, isNisa, isListed])
}

/// 期首残高の金融機関別内訳(任意)。`OpeningBalance`は銘柄単位の合計しか
/// 持たないため、同一銘柄を複数の金融機関(取引所・証券会社)にまたがって
/// 保有している場合、マネーフォワード資産残高突合の数量チェック
/// (`assetBalanceReconciliation.ts`)では期首残高をどの金融機関に帰属させる
/// べきか判定できず「判定不能(期首残高の按分不可)」として見送られる。
/// このテーブルに銘柄×金融機関ごとの期首数量を登録すると、その金融機関に
/// ついてはここで登録した数量を使って数量突合ができるようになる
/// (未登録の金融機関は従来通り判定不能のまま)。既存の`OpeningBalance`とは
/// 独立した追加データのため、登録しなくても既存の計算・突合は変わらない。
model OpeningBalanceByInstitution {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  assetClass OpeningBalanceAssetClass

  /// 銘柄シンボル・銘柄コード(OpeningBalance.symbolと対応)
  symbol String

  /// 金融機関名(CryptoTrade.exchange / InvestmentTrade.broker と対応)
  institution String

  /// 年初時点の、この金融機関における保有数量
  quantity Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, assetClass, symbol, institution])
}

enum OpeningBalanceAssetClass {
  CRYPTO
  INVESTMENT
}

/// 上場株式等の譲渡損失の繰越控除(3年間)。確定申告により繰越控除の適用を
/// 受けた損失のうち、taxYearId の年初時点でまだ使い切っていない残高を
/// 発生年(originYear)ごとに保持する。控除は発生年の翌年以後3年間のみ有効で、
/// 計算エンジン側(src/lib/investment/lossCarryforward.ts)で発生年の古い順に
/// 当年の譲渡益から控除し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 暗号資産の損失(雑所得)は他の所得と損益通算・繰越ができないため対象外。
model InvestmentLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// FX・先物・CFD等(「先物取引に係る雑所得等」)の損失の繰越控除(3年間)。
/// InvestmentLossCarryforwardと同じ制度(発生年の翌年以後3年間、同区分の所得
/// からのみ控除可能)だが、上場株式等の譲渡所得とはプールが完全に分かれており
/// 相互に流用できないため、別テーブルとして保持する。taxYearId の年初時点で
/// まだ使い切っていない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (src/lib/investment/lossCarryforward.ts の calculateLossCarryforward を
/// FuturesTrade分に対して再利用する)で発生年の古い順に当年の損益から控除し、
/// 期限(発生年+3年)を超えた分は自動的に無効とする。
model FuturesLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除限度超過額。国外所得税額のうち、
/// その年の控除限度額を超えて控除しきれなかった額は、発生した年分の翌年以後
/// 3年間繰り越して、限度額に余りが生じた年の控除に充当できる。
/// InvestmentLossCarryforward と同様、taxYearId の年初時点でまだ使い切って
/// いない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (src/lib/investment/foreignTaxCredit.ts)で発生年の古い順に当年の限度額の
/// 余りへ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 限度額に余りが生じた場合の「控除余裕額」側の繰越は
/// ForeignTaxCreditSpareLimitCarryforward で別途保持する。
model ForeignTaxCreditCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除限度超過額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な限度超過額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除余裕額。ある年の控除限度額に対して
/// 外国所得税額が少なく限度額が余った場合、その余裕額は発生した年分の翌年以後
/// 3年間繰り越して、外国所得税額が限度額を超えた年(控除限度超過額が発生する年)
/// の控除に充当できる。ForeignTaxCreditCarryforward(限度超過額側)と対になる
/// 繰越で、taxYearId の年初時点でまだ使い切っていない残高を発生年(originYear)
/// ごとに保持し、計算エンジン側(src/lib/investment/foreignTaxCredit.ts)で発生年の
/// 古い順に当年の限度超過額へ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
model ForeignTaxCreditSpareLimitCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除余裕額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越可能な控除余裕額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 雑損失の繰越控除(3年間・所得税法71条)。雑損控除額(src/lib/casualtyLossDeduction.ts)
/// がその年の総所得金額等を超えて控除しきれなかった場合、その超過額(雑損失の金額)は
/// 発生した年分の翌年以後3年間、総所得金額等から控除できる。InvestmentLossCarryforward等
/// と同様、taxYearId の年初時点でまだ使い切っていない残高を発生年(originYear)ごとに
/// 保持し、計算エンジン側(src/lib/casualtyLossCarryforward.ts)で発生年の古い順に
/// 当年の総所得金額等から控除し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 雑損控除は所得税・住民税で同一の算式のため、繰越残高も税目を分けず単一のプールで
/// 保持する。
model CasualtyLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 雑損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な雑損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 特定居住用財産の譲渡損失の損益通算及び繰越控除の特例(措置法41条の5の2)の繰越控除
/// (3年間)。損益通算の対象になる譲渡損失額(src/lib/realEstate/
/// homeSaleLossCarryforward.ts の calculateHomeSaleLoss)がその年の総所得金額等を
/// 超えて控除しきれなかった場合、その超過額は発生した年分の翌年以後3年間、総所得
/// 金額等から控除できる。CasualtyLossCarryforward等と同様、taxYearId の年初時点で
/// まだ使い切っていない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (calculateHomeSaleLossCarryforward)で発生年の古い順に当年の総所得金額等から
/// 控除し、期限(発生年+3年)を超えた分は自動的に無効とする。雑損失の繰越控除と
/// 異なり、繰越控除を適用する年の合計所得金額が3,000万円を超える場合はその年は
/// 繰越控除を適用できない点に注意(計算エンジン側で判定)。
model HomeSaleLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 譲渡損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な譲渡損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 居住用財産の買換え等の場合の譲渡損失の損益通算及び繰越控除の特例(措置法41条の5)の
/// 繰越控除(3年間)。HomeSaleLossCarryforward(措置法41条の5の2)と同様の発生年
/// (originYear)ごとの残高管理・計算エンジン側(src/lib/realEstate/
/// homeReplacementLossCarryforward.ts の calculateHomeReplacementLossCarryforward)で
/// 発生年の古い順に当年の総所得金額等から控除する仕組みだが、繰越控除を適用する年は
/// 合計所得金額3,000万円以下に加え、その年の12月31日時点で買換資産(新居宅)に係る
/// 償還期間10年以上の住宅借入金等を有することも要件になる点が固有(計算エンジン側で判定)。
model HomeReplacementLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 譲渡損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な譲渡損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 給与所得の試算(`src/lib/employmentIncome.ts`・`/employment-income`)で登録した
/// 年分ごとの給与収入金額(源泉徴収票の「支払金額」)を保存する。`/tax-estimate`は
/// これまで所得控除の登録が無い場合の「給与所得等の課税所得金額」の初期値として
/// 実際の給与収入額とは無関係な固定値(500万円)を使っていたが、ここに登録すると
/// 実際の給与収入金額から`employmentIncomeDeductionJpy`
/// (`src/lib/specificExpenseDeduction.ts`)で計算した給与所得金額を初期値の
/// 基礎として使う(登録後も入力欄は手入力で上書き可能)。給与所得金額自体は
/// 年分によって給与所得控除額の速算表が変わるため保存せず、参照の都度
/// 給与収入金額と年分から再計算する。
model EmploymentIncomeRecord {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// その年分の給与収入金額(源泉徴収票の「支払金額」。1か所のみを想定し、
  /// 2か所以上から給与を受ける場合は合計額をユーザー自身が入力する前提)
  grossSalaryJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
}

/// 所得控除試算画面(医療費控除・生命保険料控除・小規模企業共済等掛金控除
/// (iDeCo等)・社会保険料控除)で算出した年間の控除額を、年分・控除区分ごとに
/// 保存する。各試算画面はそれ単独では暗号資産・投資の集計とは独立しており
/// 自動連携していなかったが、ここに登録することで`/tax-estimate`の
/// 「給与所得等の課税所得金額」の初期値に自動反映できるようにする
/// (登録後も入力欄は手入力で上書き可能)。生命保険料控除は所得税と住民税とで
/// 速算表が異なり控除額が一致しないことがあるため、区分によらず所得税用・
/// 住民税用の金額を別々に保持する(生命保険料控除以外は両者に同額を入れる)。
model IncomeDeduction {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  type IncomeDeductionType

  /// 所得税の控除額
  incomeTaxAmountJpy Decimal

  /// 住民税の控除額(生命保険料控除以外は incomeTaxAmountJpy と同額)
  residentTaxAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, type])
}

/// 住宅借入金等特別控除(住宅ローン控除。src/lib/mortgageDeduction.ts)の試算結果を
/// 年分ごとに保存し、`/tax-estimate`の合計税額試算へ税額控除として自動反映する
/// ためのデータ。住宅ローン控除は所得控除ではなく所得税額・住民税額そのものから
/// 直接差し引く税額控除のため、`IncomeDeduction`(所得控除)とは別テーブルとして
/// 保持する。`/mortgage-deduction`の「この年分の住宅ローン控除として登録する」
/// ボタンから登録する。1年につき居住中の住宅は通常1件のため年分ごとに1件のみ保持する。
model MortgageDeductionRecord {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// その年分の所得税の控除額(MortgageDeductionResult.nationalTaxCreditJpy)
  nationalTaxCreditJpy Decimal

  /// 所得税から控除しきれず住民税から控除される額(MortgageDeductionResult.
  /// residentTaxCreditJpy)。試算時に未算出(住宅ローン控除適用前の所得税額が
  /// 未入力)だった場合は0円として保存する。
  residentTaxCreditJpy Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
}

/// 外国税額控除(src/lib/investment/foreignTaxCredit.ts)の当年分の試算結果
/// (合計控除額)を年分ごとに保存し、下書きCSV(src/lib/etax/csvExport.ts)の
/// 税額控除欄に自動反映するためのデータ。控除の計算に必要な所得税額・所得総額
/// 等はこのツールでは保有していない(都度入力の試算のため)ので、計算結果である
/// 合計控除額のみを`/foreign-tax-credit`の「この年分の外国税額控除として登録する」
/// ボタンから保存する方式にしている。繰越控除額(限度超過額・控除余裕額)は
/// ForeignTaxCreditCarryforward/ForeignTaxCreditSpareLimitCarryforwardで別途管理する。
model ForeignTaxCreditRecord {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// その年分に外国税額控除として使える合計額(ForeignTaxCreditResult.totalCreditJpy。
  /// 所得税・復興特別所得税・住民税からの控除額の合計)
  totalCreditJpy Decimal

  /// totalCreditJpyのうち所得税額・復興特別所得税額から控除される額
  /// (ForeignTaxCreditResult.nationalTaxCreditJpy)。`/tax-estimate`の合計税額試算へ
  /// 税額控除として自動反映するために使う。既存レコード(機能48以前に登録済みの年分)には
  /// 存在しないため既定値0円とする。
  nationalTaxCreditJpy Decimal @default(0)

  /// totalCreditJpyのうち住民税額から控除される額(ForeignTaxCreditResult.residentTaxCreditJpy)
  residentTaxCreditJpy Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
}

/// 住民税の調整控除(src/lib/residentTaxAdjustmentDeduction.ts)の試算結果を
/// 年分ごとに保存し、`/tax-estimate`の合計税額試算へ税額控除として自動反映する
/// ためのデータ。住宅ローン控除(MortgageDeductionRecord)・外国税額控除
/// (ForeignTaxCreditRecord)と同様、`/resident-tax-adjustment-deduction`の
/// 「この年分の住民税の調整控除として登録する」ボタンから登録する。調整控除は
/// 住民税所得割のみに適用される制度(所得税に対応する控除は無い)のため、
/// 住民税分の控除額1列のみを保持する。
model ResidentTaxAdjustmentDeductionRecord {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

