  /// 居住年の所得税額から控除しきれなかった金額(翌年分のみ繰越可能)
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId])
}

enum IncomeDeductionType {
  /// 医療費控除(src/lib/medicalExpenseDeduction.ts)
  MEDICAL_EXPENSE
  /// 生命保険料控除(src/lib/lifeInsuranceDeduction.ts)
  LIFE_INSURANCE
  /// 地震保険料控除(src/lib/earthquakeInsuranceDeduction.ts)
  EARTHQUAKE_INSURANCE
  /// 小規模企業共済等掛金控除・iDeCo等(src/lib/smallBusinessMutualAidDeduction.ts)
  SMALL_BUSINESS_MUTUAL_AID
  /// 社会保険料控除(src/lib/socialInsuranceDeduction.ts)
  SOCIAL_INSURANCE
  /// セルフメディケーション税制(src/lib/selfMedicationDeduction.ts)。
  /// MEDICAL_EXPENSEとは選択制で併用できないため、合計額の算出では
  /// 両方が登録されている場合に有利な方のみを採用する(incomeDeduction.ts参照)。
  SELF_MEDICATION
  /// 配偶者控除・配偶者特別控除(src/lib/dependentDeduction.ts)
  SPOUSE
  /// 扶養控除(src/lib/dependentDeduction.ts)
  DEPENDENT
  /// 基礎控除(src/lib/basicDeduction.ts)
  BASIC
  /// 障害者控除(src/lib/disabilityDeduction.ts)
  DISABILITY
  /// 寡婦控除・ひとり親控除(src/lib/widowSingleParentDeduction.ts)
  WIDOW_SINGLE_PARENT
  /// 勤労学生控除(src/lib/widowSingleParentDeduction.ts)
  WORKING_STUDENT
  /// 雑損控除(src/lib/casualtyLossDeduction.ts)
  CASUALTY_LOSS
  /// 寄附金控除・ふるさと納税等(src/lib/donationDeduction.ts)
  DONATION
  /// 特定支出控除(src/lib/specificExpenseDeduction.ts)。厳密には「所得控除」
  /// ではなく給与所得の計算上の控除だが、本ツールでは他の所得控除と同様に
  /// 合算して試算する簡略化としている(incomeDeduction.ts参照)。
  SPECIFIC_EXPENSE
  /// 所得金額調整控除(src/lib/incomeAmountAdjustmentDeduction.ts)。
  /// SPECIFIC_EXPENSEと同様、厳密には「所得控除」ではなく給与所得の
  /// 計算上の控除だが、本ツールでは他の所得控除と同様に合算して試算する
  /// 簡略化としている(incomeDeduction.ts参照)。
  INCOME_AMOUNT_ADJUSTMENT
  /// 特定居住用財産の譲渡損失の損益通算(措置法41条の5の2。
  /// src/lib/realEstate/homeSaleLossCarryforward.ts)。SPECIFIC_EXPENSE等と
  /// 同様、厳密には「所得控除」ではなく譲渡所得の損失をその年の総所得金額等と
  /// 損益通算するものだが、本ツールでは他の所得控除と同様に合算して試算する
  /// 簡略化としている(incomeDeduction.ts参照)。
  HOME_SALE_LOSS
  /// 居住用財産の買換え等の場合の譲渡損失の損益通算(措置法41条の5。
  /// src/lib/realEstate/homeReplacementLossCarryforward.ts)。HOME_SALE_LOSSと同様、
  /// 厳密には「所得控除」ではなく譲渡所得の損失をその年の総所得金額等と損益通算する
  /// ものだが、本ツールでは他の所得控除と同様に合算して試算する簡略化としている
  /// (incomeDeduction.ts参照)。
  HOME_REPLACEMENT_LOSS
}

/// NISA生涯投資枠(2024年以降の新NISA制度における総枠1,800万円・
/// うち成長投資枠1,200万円)の使用状況試算用データ。年間投資枠
/// (src/lib/investment/nisaQuota.ts の calculateNisaQuotaUsage)はその年の
/// 買付だけを見れば判定できるが、生涯投資枠は過去の買付・売却の累積
/// (簿価残高)を追わないと判定できない。売却により再利用可能になった枠は
/// 売却した年の翌年から使えるようになるため、本テーブルには taxYearId の
/// 年始時点で確定している「使用額」(前年末の保有簿価残高)を枠区分ごとに
/// 保持し、当年の買付額を加算して当年末の使用額(翌年への繰越額)を計算する。
/// 当年中に売却した保有分の取得価額(簿価)は自動追跡せず、ユーザーが
/// soldCostBasisJpy に手入力する(OpeningBalance等と同様、本ツールが
/// 過去の取引を全件保持している保証がないための簡略化)。
model NisaLifetimeQuota {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  nisaType InvestmentNisaType

  /// 年始時点の非課税枠使用額(前年末時点の保有簿価残高)
  openingUsedJpy Decimal

  /// 当年中に売却した、この枠で買い付けた保有分の取得価額(簿価)の合計(手入力)。
  /// 翌年への繰越額(=翌年の年始使用額)の算出にのみ使う
  /// (売却による枠の再利用は翌年からのため、当年の買付可否判定には使わない)。
  soldCostBasisJpy Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, nisaType])
}

/// 暗号資産の売買・交換・使用等の取引履歴。
/// 国税庁「暗号資産に関する税務上の取扱いについて」に基づき、
/// 総平均法(または移動平均法)で1単位あたりの取得価額を算出する。
model CryptoTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 取引日時 (JST)
  tradedAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// buy: 円などの法定通貨で購入 / sell: 法定通貨に売却
  /// trade_in / trade_out: 暗号資産同士の交換(この取引で増える/減る側)
  /// income: マイニング・ステーキング・エアドロップ等による取得(取得時時価で収入計上)
  /// gift_in: 贈与・遺贈・相続等により取得(取得価額をそのまま引き継ぐため取得時の収入計上は無し)
  /// fee: 取引手数料(暗号資産建てで支払われた場合)
  type CryptoTradeType

  /// 数量(増減の絶対値)。取得数量 or 譲渡数量。
  quantity Decimal

  /// 単価(日本円換算)。income/tradeでは取得時の時価を入力する。
  unitPriceJpy Decimal

  /// 手数料(日本円換算、取得価額 or 譲渡価額の調整に使用)
  feeJpy Decimal @default(0)

  /// 取引所・ウォレット名
  exchange String?

  /// メモ
  memo String?

  /// インポート元(手動 / moneyforward / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

enum CryptoTradeType {
  BUY
  SELL
  TRADE_IN
  TRADE_OUT
  INCOME
  GIFT_IN
  FEE
}

/// 暗号資産の証拠金(レバレッジ)取引の決済損益。DMM Bitcoin・SBI VCトレード等の
/// 証拠金取引は、現物取引のように数量×単価で取得費を積み上げる総平均法/移動
/// 平均法の計算モデルにはあてはまらず、決済(反対売買)のたびに確定する
/// 建玉損益がそのまま雑所得の収入・損失になる。そのため CryptoTrade とは別に、
/// 決済ごとの損益をそのまま合算するだけのシンプルなモデルとして保持する。
model CryptoMarginTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買が成立した日時)
  settledAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// 決済損益(円)。建玉を閉じた際の損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 取引手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// スワップポイント・建玉管理料等(円)。損益に加算する(費用の場合は負の値)。
  swapJpy Decimal @default(0)

  /// 取引所名
  exchange String?

  memo String?

  /// インポート元(手動 / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

/// FX(店頭外国為替証拠金取引)・先物・CFD等の決済損益。所得税法上「先物取引に
/// 係る雑所得等」として、上場株式等の譲渡所得(InvestmentTrade)や暗号資産の
/// 雑所得(CryptoTrade/CryptoMarginTrade)とは別区分の申告分離課税
/// (一律20.315%)の対象になり、損益通算・繰越控除も他の所得区分とは
/// プールを分けて計算しなければならない。CryptoMarginTradeと同様、建玉の
/// 決済(反対売買・差金決済)のたびに確定する損益をそのまま合算するだけの
/// シンプルなモデルとして保持する(数量×単価による取得費の積み上げは行わない)。
model FuturesTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買・差金決済が成立した日時)
  settledAt DateTime

  /// 銘柄・通貨ペア名 (例: USD/JPY, 日経225先物)
  symbol String

  /// 決済損益(円)。建玉を閉じた際の損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 取引手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// スワップポイント等(円。FXのみ発生。損益に加算する。費用の場合は負の値)
  swapJpy Decimal @default(0)

  /// 取引業者名
  broker String?

  memo String?

  /// インポート元(手動 / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

/// 株式・投資信託・ETF等の売買履歴。
/// 特定口座(源泉徴収あり/なし)・一般口座・NISA区分を保持し、
/// 譲渡所得(申告分離課税)の計算に使う。
model InvestmentTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  tradedAt DateTime

  /// 銘柄コード・ティッカー
  symbol String

  /// 銘柄名
  name String?

  assetType InvestmentAssetType

  /// J-REIT(不動産投資信託)かどうか(assetType=ETFの場合のみ意味を持つ)。
  /// ETFは通常上場株式等の普通配当と同じ配当控除率で扱うが、J-REIT型ETF
  /// (不動産投資法人が発行する投資証券)は法人税が実質非課税のため
  /// 配当控除の対象外(0%)。type=DIVIDENDのレコードの配当控除率区分の
  /// 判定(`src/lib/investment/calculator.ts`の`dividendCreditCategory`)にのみ使う。
  isReit Boolean @default(false)

  /// 株式投資信託(assetType=MUTUAL_FUND)の分配金につき、外貨建資産・公社債等の
  /// 組入割合が50%超75%以下かどうか(投資信託説明書・運用報告書で確認)。
  /// 組入割合50%以下(既定値false)は通常の半分税率(HALF)だが、50%超75%以下は
  /// さらに率が下がる1/4税率(QUARTER)の対象になる(75%超は
  /// mutualFundVeryHighForeignRatioで区別する。
  /// `src/lib/investment/calculator.ts`の`dividendCreditCategory`参照)。
  /// type=DIVIDENDのレコードの配当控除率区分の判定にのみ使う。
  mutualFundHighForeignRatio Boolean @default(false)

  /// 株式投資信託(assetType=MUTUAL_FUND)の分配金につき、外貨建資産・公社債等の
  /// 組入割合が75%超かどうか(投資信託説明書・運用報告書で確認)。国税庁
  /// タックスアンサーNo.1250の速算表により、組入割合75%超の株式投資信託の
  /// 収益分配金は配当控除の対象外(NONE)になる(mutualFundHighForeignRatioの
  /// 値に関わらずこちらが優先される)。type=DIVIDENDのレコードの配当控除率
  /// 区分の判定にのみ使う。
  mutualFundVeryHighForeignRatio Boolean @default(false)

  /// 上場株式等(true)か一般株式等・非上場株式(false)かの区分。国税庁は
  /// 両者を別プールの申告分離課税として扱い、損益通算はできない。また
  /// 譲渡損失の繰越控除(措置法37の12の2)は上場株式等のみに認められた制度
  /// のため、一般株式等の譲渡損失は当年限りで切り捨てられる(繰越不可)。
  /// NISA口座は上場株式等・ETF・株式投資信託等のみが対象のため、
  /// isListed=falseの場合isNisa=trueは想定しない(登録時に拒否する)。
  isListed Boolean @default(true)

  type InvestmentTradeType

  quantity Decimal

  /// 約定単価(円)
  unitPriceJpy Decimal

  /// 手数料(円)
  feeJpy Decimal @default(0)

  /// 口座区分
  accountType InvestmentAccountType @default(SPECIFIC_WITHHOLDING)

  /// NISA区分(該当する場合、非課税のため損益計算から除外)
  isNisa Boolean @default(false)

  /// NISAの年間投資枠区分(isNisa=true かつ type=BUY の場合のみ入力する想定)。
  /// つみたて投資枠(年120万円)・成長投資枠(年240万円)の使用状況試算
  /// (src/lib/investment/nisaQuota.ts)に使う。未入力(null)の場合は
  /// どちらの枠の使用額にも計上されず、試算画面で「未分類」として警告表示する。
  nisaType InvestmentNisaType?

  /// 国外で発行された株式・投資信託等かどうか。米国株等の配当は現地でも
  /// 源泉徴収されることが多く、外国税額控除(所得税法95条)の対象となる
  /// 国外所得金額の自動集計に使う(type=DIVIDENDのレコードのみ対象)。
  isForeign Boolean @default(false)

  /// 配当・分配金(type=DIVIDEND)につき現地で源泉徴収された外国所得税額
  /// (日本円換算、isForeign=trueの場合のみ入力する想定)。
  /// `/foreign-tax-credit`の外国所得税額の自動集計に使う。
  foreignTaxWithheldJpy Decimal @default(0)

  /// 配当・分配金(type=DIVIDEND)につき、特定口座年間取引報告書等に記載された
  /// 分配時調整外国税相当額(所得税法93条の2。日本円換算)。投資信託等が保有する
  /// 国外資産から生じた利子・配当等につき信託段階で源泉徴収された外国所得税額の
  /// うち、受益者の所得金額の計算上必要経費又は取得費に算入されない部分として
  /// 計算された金額で、isForeign(銘柄自体が国外発行かどうか)を問わず、国内籍の
  /// 投資信託・ETFの分配金にも生じうる。`/distribution-adjusted-foreign-tax-credit`
  /// の自動集計に使う。
  distributionAdjustedForeignTaxJpy Decimal @default(0)

  broker String?
  memo   String?

  source        String       @default("manual")
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

/// 上場株式等の信用取引(制度信用取引・一般信用取引)の決済損益。
/// InvestmentTradeのように数量×単価で取得費を積み上げる計算モデルにはあてはまらず、
/// CryptoMarginTrade/FuturesTradeと同様、決済(反対売買・差金決済)のたびに確定する
/// 建玉損益をそのまま合算するだけのシンプルなモデルとして保持する。ただし課税区分は
/// 現物の上場株式等と同じ「上場株式等に係る譲渡所得等」のプールに合算され、
/// 上場株式等の譲渡損失の繰越控除(措置法37の12の2)の対象にもなる点が、別プールの
/// 暗号資産の証拠金取引(雑所得)や先物取引(先物取引に係る雑所得等)と異なる
/// (src/lib/investment/marginCalculator.ts参照)。信用取引にNISA口座は適用されない。
model StockMarginTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買・差金決済が成立した日時)
  settledAt DateTime

  /// 銘柄コード・ティッカー
  symbol String

  /// 決済損益(円)。建玉を閉じた際の値洗い損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 売買手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// 金利相当額・品貸料・配当落調整額(権利処理価額)の純額調整(円)。
  /// 収入超過ならプラス、費用超過ならマイナスとして損益に加算する。
  interestAdjustmentJpy Decimal @default(0)

  /// 証券会社名
  broker String?

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

enum InvestmentAssetType {
  STOCK
  ETF
  MUTUAL_FUND
  BOND
  OTHER
}

enum InvestmentTradeType {
  BUY
  SELL
  DIVIDEND
}

enum InvestmentAccountType {
  SPECIFIC_WITHHOLDING
  SPECIFIC_NO_WITHHOLDING
  GENERAL
  NISA
}

/// NISAの年間投資枠区分(2024年以降の新NISA制度)
enum InvestmentNisaType {
  /// つみたて投資枠(年間上限120万円)
  TSUMITATE
  /// 成長投資枠(年間上限240万円)
  GROWTH
}

/// 証券会社が発行する「特定口座年間取引報告書」の年間サマリー数値。
/// 損益計算そのものには使わず、アプリ内でInvestmentTradeから計算した
/// 証券会社・口座区分ごとの譲渡収入金額・配当等の額と突き合わせて、
/// 取引の入力漏れ・入力ミスを検知するための参照データとして保持する。
/// 取得費は証券会社が口座ごとに管理する取得原価(本ツールが銘柄単位・
/// 全口座合算で計算する平均単価とは前提が異なる)のため自動突合の対象にはせず、
/// 参考値として登録するのみとする。
model BrokerAnnualReport {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 証券会社名(InvestmentTrade.broker と同じ表記で入力する想定)
  broker String

  /// 口座区分。年間取引報告書が発行されるのは通常、特定口座(源泉徴収あり/なし)。
  accountType InvestmentAccountType

  /// 年間取引報告書「譲渡の対価の額(収入金額)」の合計
  proceedsJpy Decimal

  /// 年間取引報告書「取得費及び譲渡に要した費用の額等」の合計(参考値。自動突合の対象外)
  acquisitionCostJpy Decimal

  /// 年間取引報告書「配当等の額」の合計(任意)
  dividendJpy Decimal @default(0)

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, broker, accountType])
}

/// マネーフォワード ME 等からインポートしたCSVの取り込みバッチ。
/// 生データを保持し、後から再取り込み・突合ができるようにする。
model ImportBatch {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// moneyforward_cashflow / moneyforward_assets / crypto_csv / investment_csv
  sourceType String

  fileName   String
  importedAt DateTime @default(now())
  rowCount   Int      @default(0)

  cryptoTrades          CryptoTrade[]
  cryptoMarginTrades    CryptoMarginTrade[]
  futuresTrades         FuturesTrade[]
  investmentTrades      InvestmentTrade[]
  cashflowEntries       CashflowEntry[]
  assetBalanceSnapshots AssetBalanceSnapshot[]
}

/// マネーフォワード ME の家計簿(収支)データ。
/// 事業所得・雑所得の経費按分や、暗号資産取引の見落とし検出などに利用する。
model CashflowEntry {
  id            Int         @id @default(autoincrement())
  importBatchId Int
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])

  date                DateTime
  content             String
  amountJpy           Decimal
  /// 収入 / 支出
  direction           CashflowDirection
  largeCategory       String?
  middleCategory      String?
  institution         String?
  memo                String?
  /// マネーフォワード側の計算対象フラグ(集計除外の振替等を判別)
  isCalculationTarget Boolean           @default(true)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([largeCategory, middleCategory])
}

enum CashflowDirection {
  INCOME
  EXPENSE
}

/// マネーフォワードの資産名(例:「ビットコイン」)とアプリ側の銘柄シンボル
/// (例:「BTC」。CryptoTrade.symbol / InvestmentTrade.symbol と対応)の
/// 対応表。資産残高突合(assetBalanceReconciliation.ts)で、金融機関単位の
/// 突合に加えて銘柄単位での突合まで踏み込むために使う。対応関係は年をまたいで
/// 変わらないマスタデータのため、TaxYearには紐付けない全年共通のテーブルとする。
model AssetSymbolMapping {
  id Int @id @default(autoincrement())

  /// マネーフォワード側の資産名表記(完全一致で対応付ける)
  assetName String @unique

  /// アプリ側の銘柄シンボル・銘柄コード
  symbol String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 銘柄ごとの現在価格(時価)のユーザー手入力。自動取得の仕組みは持たない
/// (/import「現在価格(時価)の登録」欄から登録・更新する)。年に紐付かない
/// 全年共通のマスタデータで、以下2箇所から参照する:
///  - `/unrealized-gain`(含み損益シミュレーション)の現在価格欄の初期値
///  - `assetBalanceReconciliation.ts`の`reconcileAssetSymbolBalances`による
///    マネーフォワード資産残高突合の評価額比較(期首残高+当年増減の期待保有数量
///    ×この価格と、マネーフォワード側の評価額を比較する)。手入力の価格は
///    マネーフォワード側の評価時点とずれるため、大きな乖離のみを検知する目安
///    情報として扱う。
model MarketPrice {
  id Int @id @default(autoincrement())

  /// アプリ側の銘柄シンボル・銘柄コード(大文字で正規化して保存する)
  symbol String @unique

  /// 1単位あたりの現在価格(円)
  priceJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// パスワード認証のログイン失敗試行(ブルートフォース対策)。IPアドレス単位で
/// 直近の失敗回数を数え、一定回数を超えたら一時的にログインを拒否する
/// (src/lib/auth/loginRateLimit.ts)。TaxYearに紐付かない全年共通のテーブル。
/// 成功時はそのIPアドレス分のレコードを削除し、期限切れレコードも都度削除する
/// ため、長期間肥大化しない。
model LoginAttempt {
  id Int @id @default(autoincrement())

  /// 失敗した接続元のIPアドレス(X-Forwarded-For等から取得。取得できない場合は"unknown")
  ipAddress String

  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

/// マネーフォワード ME の「資産の内訳」CSVから取り込んだ、ある時点の
/// 金融機関・資産別の残高(評価額)。損益計算そのものには使わず、アプリに
/// 登録済みの暗号資産・投資取引の金融機関(CryptoTrade.exchange /
/// InvestmentTrade.broker)と突き合わせて、残高はあるのに取引明細が
/// 一件も登録されていない金融機関(計上漏れの疑い)や、逆に取引明細は
/// あるのにマネーフォワード側の資産残高に見当たらない金融機関を検知する
/// 参照データとして保持する(src/lib/moneyforward/assetBalanceReconciliation.ts)。
/// CSVの列見出しは公開情報から確認できておらず未検証のため、専用プリセットは
/// 用意せずユーザーが列名を指定する汎用マッピング方式のみで取り込む。
model AssetBalanceSnapshot {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 残高時点の日付(CSVに日付列が無い/指定しない場合はインポート日時を使う)
  snapshotDate DateTime @default(now())

  /// マネーフォワード側の大分類・種類(任意。列を指定しない場合は空文字)
  category String @default("")

  /// 保有金融機関名(例: bitFlyer, SBI証券)。CryptoTrade.exchange /
  /// InvestmentTrade.broker と同じ表記を想定する。
  institution String

  /// 資産名(例: ビットコイン、楽天・全世界株式インデックス・ファンド)
  assetName String

  /// 残高・評価額(円)
  balanceJpy Decimal

  /// 保有数量(任意)。列を指定しない/CSVに無い場合はnull。
  /// アプリ内取引明細から計算した数量との突合(quantityの整合性チェック)に使う。
  quantity Decimal?

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())

  @@index([taxYearId, institution])
}
