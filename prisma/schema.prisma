// 確定申告支援ツール データモデル
//
// 対象範囲(初期版):
//  - 暗号資産(仮想通貨)取引 -> 雑所得の計算
//  - 有価証券(株式・投資信託等)取引 -> 譲渡所得/配当所得の計算
//  - マネーフォワード ME からインポートした取引明細
//
// 将来的に確定申告書等作成コーナーへの連携・e-Taxデータ出力を強化する。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 課税年度(申告対象の暦年)。日本の所得税は暦年単位(1/1-12/31)で計算する。
model TaxYear {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  createdAt DateTime @default(now())

  /// 暗号資産の評価方法。所得税法上、届出が無い場合の法定算出方法は総平均法。
  /// 移動平均法を選択する場合は税務署への届出(所得税の暗号資産の評価方法の
  /// 届出書)が必要で、一度選択すると原則3年間変更できない点に注意。
  cryptoCostMethod CryptoCostMethod @default(AVERAGE)

  cryptoTrades                            CryptoTrade[]
  cryptoMarginTrades                      CryptoMarginTrade[]
  investmentTrades                        InvestmentTrade[]
  importBatches                           ImportBatch[]
  openingBalances                         OpeningBalance[]
  investmentLossCarryforwards             InvestmentLossCarryforward[]
  brokerAnnualReports                     BrokerAnnualReport[]
  assetBalanceSnapshots                   AssetBalanceSnapshot[]
  foreignTaxCreditCarryforwards           ForeignTaxCreditCarryforward[]
  foreignTaxCreditSpareLimitCarryforwards ForeignTaxCreditSpareLimitCarryforward[]
}

enum CryptoCostMethod {
  /// 総平均法(届出が無い場合の法定算出方法)
  AVERAGE
  /// 移動平均法(税務署への届出により選択可能)
  MOVING_AVERAGE
}

/// 前年からの繰越残高(期首残高)。暗号資産・株式等の総平均法/移動平均法による
/// 取得費計算は複数年にまたがるため、年初の保有数量と取得価額の合計を
/// ここに保持し、当年の計算エンジンへ opening 引数として渡す。
model OpeningBalance {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  assetClass OpeningBalanceAssetClass

  /// 銘柄シンボル・銘柄コード(CryptoTrade.symbol / InvestmentTrade.symbol と対応)
  symbol String

  /// 投資(INVESTMENT)のみ有効。NISA口座分の期首残高かどうか。
  /// NISA口座は課税口座と別ロットのため、同一銘柄でも別レコードになる。
  /// 暗号資産(CRYPTO)では常に false。
  isNisa Boolean @default(false)

  /// 年初時点の保有数量
  quantity Decimal

  /// 年初時点の取得価額の合計(単価ではなく総額)
  costBasisJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, assetClass, symbol, isNisa])
}

enum OpeningBalanceAssetClass {
  CRYPTO
  INVESTMENT
}

/// 上場株式等の譲渡損失の繰越控除(3年間)。確定申告により繰越控除の適用を
/// 受けた損失のうち、taxYearId の年初時点でまだ使い切っていない残高を
/// 発生年(originYear)ごとに保持する。控除は発生年の翌年以後3年間のみ有効で、
/// 計算エンジン側(src/lib/investment/lossCarryforward.ts)で発生年の古い順に
/// 当年の譲渡益から控除し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 暗号資産の損失(雑所得)は他の所得と損益通算・繰越ができないため対象外。
model InvestmentLossCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 損失が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な損失額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除限度超過額。国外所得税額のうち、
/// その年の控除限度額を超えて控除しきれなかった額は、発生した年分の翌年以後
/// 3年間繰り越して、限度額に余りが生じた年の控除に充当できる。
/// InvestmentLossCarryforward と同様、taxYearId の年初時点でまだ使い切って
/// いない残高を発生年(originYear)ごとに保持し、計算エンジン側
/// (src/lib/investment/foreignTaxCredit.ts)で発生年の古い順に当年の限度額の
/// 余りへ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
/// 限度額に余りが生じた場合の「控除余裕額」側の繰越は
/// ForeignTaxCreditSpareLimitCarryforward で別途保持する。
model ForeignTaxCreditCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除限度超過額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越控除可能な限度超過額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 外国税額控除(所得税法95条)の繰越控除余裕額。ある年の控除限度額に対して
/// 外国所得税額が少なく限度額が余った場合、その余裕額は発生した年分の翌年以後
/// 3年間繰り越して、外国所得税額が限度額を超えた年(控除限度超過額が発生する年)
/// の控除に充当できる。ForeignTaxCreditCarryforward(限度超過額側)と対になる
/// 繰越で、taxYearId の年初時点でまだ使い切っていない残高を発生年(originYear)
/// ごとに保持し、計算エンジン側(src/lib/investment/foreignTaxCredit.ts)で発生年の
/// 古い順に当年の限度超過額へ充当し、期限(発生年+3年)を超えた分は自動的に無効とする。
model ForeignTaxCreditSpareLimitCarryforward {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 控除余裕額が発生した年(暦年)
  originYear Int

  /// taxYearId の年初時点で残っている繰越可能な控除余裕額
  remainingAmountJpy Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, originYear])
}

/// 暗号資産の売買・交換・使用等の取引履歴。
/// 国税庁「暗号資産に関する税務上の取扱いについて」に基づき、
/// 総平均法(または移動平均法)で1単位あたりの取得価額を算出する。
model CryptoTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 取引日時 (JST)
  tradedAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// buy: 円などの法定通貨で購入 / sell: 法定通貨に売却
  /// trade_in / trade_out: 暗号資産同士の交換(この取引で増える/減る側)
  /// income: マイニング・ステーキング・エアドロップ等による取得(取得時時価で収入計上)
  /// fee: 取引手数料(暗号資産建てで支払われた場合)
  type CryptoTradeType

  /// 数量(増減の絶対値)。取得数量 or 譲渡数量。
  quantity Decimal

  /// 単価(日本円換算)。income/tradeでは取得時の時価を入力する。
  unitPriceJpy Decimal

  /// 手数料(日本円換算、取得価額 or 譲渡価額の調整に使用)
  feeJpy Decimal @default(0)

  /// 取引所・ウォレット名
  exchange String?

  /// メモ
  memo String?

  /// インポート元(手動 / moneyforward / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

enum CryptoTradeType {
  BUY
  SELL
  TRADE_IN
  TRADE_OUT
  INCOME
  FEE
}

/// 暗号資産の証拠金(レバレッジ)取引の決済損益。DMM Bitcoin・SBI VCトレード等の
/// 証拠金取引は、現物取引のように数量×単価で取得費を積み上げる総平均法/移動
/// 平均法の計算モデルにはあてはまらず、決済(反対売買)のたびに確定する
/// 建玉損益がそのまま雑所得の収入・損失になる。そのため CryptoTrade とは別に、
/// 決済ごとの損益をそのまま合算するだけのシンプルなモデルとして保持する。
model CryptoMarginTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 決済日時(反対売買が成立した日時)
  settledAt DateTime

  /// 銘柄シンボル (例: BTC, ETH)
  symbol String

  /// 決済損益(円)。建玉を閉じた際の損益で、損失の場合は負の値。
  realizedPnlJpy Decimal

  /// 取引手数料(円。決済損益から差し引く)
  feeJpy Decimal @default(0)

  /// スワップポイント・建玉管理料等(円)。損益に加算する(費用の場合は負の値)。
  swapJpy Decimal @default(0)

  /// 取引所名
  exchange String?

  memo String?

  /// インポート元(手動 / csv など)
  source String @default("manual")

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([settledAt])
}

/// 株式・投資信託・ETF等の売買履歴。
/// 特定口座(源泉徴収あり/なし)・一般口座・NISA区分を保持し、
/// 譲渡所得(申告分離課税)の計算に使う。
model InvestmentTrade {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  tradedAt DateTime

  /// 銘柄コード・ティッカー
  symbol String

  /// 銘柄名
  name String?

  assetType InvestmentAssetType

  type InvestmentTradeType

  quantity Decimal

  /// 約定単価(円)
  unitPriceJpy Decimal

  /// 手数料(円)
  feeJpy Decimal @default(0)

  /// 口座区分
  accountType InvestmentAccountType @default(SPECIFIC_WITHHOLDING)

  /// NISA区分(該当する場合、非課税のため損益計算から除外)
  isNisa Boolean @default(false)

  /// NISAの年間投資枠区分(isNisa=true かつ type=BUY の場合のみ入力する想定)。
  /// つみたて投資枠(年120万円)・成長投資枠(年240万円)の使用状況試算
  /// (src/lib/investment/nisaQuota.ts)に使う。未入力(null)の場合は
  /// どちらの枠の使用額にも計上されず、試算画面で「未分類」として警告表示する。
  nisaType InvestmentNisaType?

  /// 国外で発行された株式・投資信託等かどうか。米国株等の配当は現地でも
  /// 源泉徴収されることが多く、外国税額控除(所得税法95条)の対象となる
  /// 国外所得金額の自動集計に使う(type=DIVIDENDのレコードのみ対象)。
  isForeign Boolean @default(false)

  /// 配当・分配金(type=DIVIDEND)につき現地で源泉徴収された外国所得税額
  /// (日本円換算、isForeign=trueの場合のみ入力する想定)。
  /// `/foreign-tax-credit`の外国所得税額の自動集計に使う。
  foreignTaxWithheldJpy Decimal @default(0)

  broker String?
  memo   String?

  source        String       @default("manual")
  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYearId, symbol])
  @@index([tradedAt])
}

enum InvestmentAssetType {
  STOCK
  ETF
  MUTUAL_FUND
  BOND
  FX
  OTHER
}

enum InvestmentTradeType {
  BUY
  SELL
  DIVIDEND
}

enum InvestmentAccountType {
  SPECIFIC_WITHHOLDING
  SPECIFIC_NO_WITHHOLDING
  GENERAL
  NISA
}

/// NISAの年間投資枠区分(2024年以降の新NISA制度)
enum InvestmentNisaType {
  /// つみたて投資枠(年間上限120万円)
  TSUMITATE
  /// 成長投資枠(年間上限240万円)
  GROWTH
}

/// 証券会社が発行する「特定口座年間取引報告書」の年間サマリー数値。
/// 損益計算そのものには使わず、アプリ内でInvestmentTradeから計算した
/// 証券会社・口座区分ごとの譲渡収入金額・配当等の額と突き合わせて、
/// 取引の入力漏れ・入力ミスを検知するための参照データとして保持する。
/// 取得費は証券会社が口座ごとに管理する取得原価(本ツールが銘柄単位・
/// 全口座合算で計算する平均単価とは前提が異なる)のため自動突合の対象にはせず、
/// 参考値として登録するのみとする。
model BrokerAnnualReport {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 証券会社名(InvestmentTrade.broker と同じ表記で入力する想定)
  broker String

  /// 口座区分。年間取引報告書が発行されるのは通常、特定口座(源泉徴収あり/なし)。
  accountType InvestmentAccountType

  /// 年間取引報告書「譲渡の対価の額(収入金額)」の合計
  proceedsJpy Decimal

  /// 年間取引報告書「取得費及び譲渡に要した費用の額等」の合計(参考値。自動突合の対象外)
  acquisitionCostJpy Decimal

  /// 年間取引報告書「配当等の額」の合計(任意)
  dividendJpy Decimal @default(0)

  memo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYearId, broker, accountType])
}

/// マネーフォワード ME 等からインポートしたCSVの取り込みバッチ。
/// 生データを保持し、後から再取り込み・突合ができるようにする。
model ImportBatch {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// moneyforward_cashflow / moneyforward_assets / crypto_csv / investment_csv
  sourceType String

  fileName   String
  importedAt DateTime @default(now())
  rowCount   Int      @default(0)

  cryptoTrades          CryptoTrade[]
  cryptoMarginTrades    CryptoMarginTrade[]
  investmentTrades      InvestmentTrade[]
  cashflowEntries       CashflowEntry[]
  assetBalanceSnapshots AssetBalanceSnapshot[]
}

/// マネーフォワード ME の家計簿(収支)データ。
/// 事業所得・雑所得の経費按分や、暗号資産取引の見落とし検出などに利用する。
model CashflowEntry {
  id            Int         @id @default(autoincrement())
  importBatchId Int
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])

  date                DateTime
  content             String
  amountJpy           Decimal
  /// 収入 / 支出
  direction           CashflowDirection
  largeCategory       String?
  middleCategory      String?
  institution         String?
  memo                String?
  /// マネーフォワード側の計算対象フラグ(集計除外の振替等を判別)
  isCalculationTarget Boolean           @default(true)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([largeCategory, middleCategory])
}

enum CashflowDirection {
  INCOME
  EXPENSE
}

/// マネーフォワードの資産名(例:「ビットコイン」)とアプリ側の銘柄シンボル
/// (例:「BTC」。CryptoTrade.symbol / InvestmentTrade.symbol と対応)の
/// 対応表。資産残高突合(assetBalanceReconciliation.ts)で、金融機関単位の
/// 突合に加えて銘柄単位での突合まで踏み込むために使う。対応関係は年をまたいで
/// 変わらないマスタデータのため、TaxYearには紐付けない全年共通のテーブルとする。
model AssetSymbolMapping {
  id Int @id @default(autoincrement())

  /// マネーフォワード側の資産名表記(完全一致で対応付ける)
  assetName String @unique

  /// アプリ側の銘柄シンボル・銘柄コード
  symbol String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// マネーフォワード ME の「資産の内訳」CSVから取り込んだ、ある時点の
/// 金融機関・資産別の残高(評価額)。損益計算そのものには使わず、アプリに
/// 登録済みの暗号資産・投資取引の金融機関(CryptoTrade.exchange /
/// InvestmentTrade.broker)と突き合わせて、残高はあるのに取引明細が
/// 一件も登録されていない金融機関(計上漏れの疑い)や、逆に取引明細は
/// あるのにマネーフォワード側の資産残高に見当たらない金融機関を検知する
/// 参照データとして保持する(src/lib/moneyforward/assetBalanceReconciliation.ts)。
/// CSVの列見出しは公開情報から確認できておらず未検証のため、専用プリセットは
/// 用意せずユーザーが列名を指定する汎用マッピング方式のみで取り込む。
model AssetBalanceSnapshot {
  id        Int     @id @default(autoincrement())
  taxYearId Int
  taxYear   TaxYear @relation(fields: [taxYearId], references: [id])

  /// 残高時点の日付(CSVに日付列が無い/指定しない場合はインポート日時を使う)
  snapshotDate DateTime @default(now())

  /// マネーフォワード側の大分類・種類(任意。列を指定しない場合は空文字)
  category String @default("")

  /// 保有金融機関名(例: bitFlyer, SBI証券)。CryptoTrade.exchange /
  /// InvestmentTrade.broker と同じ表記を想定する。
  institution String

  /// 資産名(例: ビットコイン、楽天・全世界株式インデックス・ファンド)
  assetName String

  /// 残高・評価額(円)
  balanceJpy Decimal

  importBatchId Int?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  createdAt DateTime @default(now())

  @@index([taxYearId, institution])
}
