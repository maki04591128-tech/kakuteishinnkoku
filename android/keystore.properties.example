# リリースAPK署名用の設定テンプレート。
# このファイルを `android/keystore.properties` としてコピーし、実際の値を入れて使う
# (`keystore.properties` 自体は android/.gitignore で除外されているためコミットされない)。
#
# GitHub Actions等のCIでは、このファイルを置く代わりに環境変数
# RELEASE_KEYSTORE_PATH / RELEASE_KEYSTORE_PASSWORD / RELEASE_KEY_ALIAS /
# RELEASE_KEY_PASSWORD を設定しても同じ効果になる(android/app/build.gradle参照)。
#
# いずれも未設定の場合はリリースビルドは単に未署名になり、ビルド自体は失敗しない。

storeFile=../release.jks
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
